<div class="container my-5">
    <div class="row">
        <div class="col-md-4">
            <h1>Estudiantes</h1>
            <ul class="list-group">
            {{#each students.docs}}
                <li class="list-group-item">{{this.apellido}}, {{this.nombre}}</li>
            {{/each}}
            </ul>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-4">
            <div class="btn-group" role="group">
                <a href="/students?page={{students.prevPage}}" type="button" class="btn btn-primary">Anterior</a>
                <button type="button" class="btn btn-primary">{{students.currentPage}}</button>
                <a href="/students?page={{students.nextPage}}" class="btn btn-primary">Siguiente</a>
            </div>
        </div>
    </div>
</div>